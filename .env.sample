# ── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_NAME=GeminiLM

# ── External Auth Service ─────────────────────────────────────────────────────
# Base URL of the shared auth service (Google OAuth + JWT issuance)
NEXT_PUBLIC_AUTH_URL=your_auth_service_uri

# Google OAuth client ID (must match the one registered with the auth service)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# RS256 public key — base64-encoded PEM from the auth service
# Generate: base64 -w0 public_key.pem  (Linux) | base64 -i public_key.pem  (macOS)
JWT_PUBLIC_KEY=your_base64_encoded_rs256_public_key

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geminilm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=geminilm

# ── MinIO (object storage) ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=documents
MINIO_USE_SSL=false
# Long random string — change in production
MINIO_WEBHOOK_SECRET=your_webhook_secret

# ── Qdrant (vector database) ──────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Leave empty if running Qdrant without an API key (local dev default)
QDRANT_API_KEY=
