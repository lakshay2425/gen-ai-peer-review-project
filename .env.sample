# ── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_NAME=GeminiLM

# ── External Auth Service ─────────────────────────────────────────────────────
# Base URL of the shared auth service (Google OAuth + JWT issuance)
NEXT_PUBLIC_AUTH_URL=your_auth_service_uri

# Google OAuth client ID (must match the one registered with the auth service)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# JWT verification uses the auth service JWKS endpoint (see lib/auth.ts).
# No JWT_PUBLIC_KEY env var is required.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geminilm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=geminilm

# ── MinIO (object storage) ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=documents
MINIO_USE_SSL=false
MINIO_WEBHOOK_SECRET=your_webhook_secret

# ── Qdrant (vector database) ──────────────────────────────────────────────────
# Local (compose.dev.yml): http://localhost:6333
# Production (docker/compose.yml): app/worker use http://qdrant:6333 automatically
QDRANT_URL=http://localhost:6333
# Leave empty for no API key (local / private compose network default)
# If set in production Coolify, the same value is passed to the qdrant service
QDRANT_API_KEY=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
