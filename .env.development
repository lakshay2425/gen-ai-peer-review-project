# ── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_NAME=GeminiLM

# ── External Auth Service ─────────────────────────────────────────────────────
# Replace these with real values from your auth service setup
NEXT_PUBLIC_AUTH_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
JWT_PUBLIC_KEY=your_base64_encoded_rs256_public_key

# ── PostgreSQL (matches docker/compose.dev.yml defaults) ─────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geminilm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=geminilm

# ── MinIO (matches docker/compose.dev.yml defaults) ──────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=documents
MINIO_USE_SSL=false
MINIO_WEBHOOK_SECRET=dev_webhook_secret_change_in_production

# ── Qdrant (matches docker/compose.dev.yml defaults) ─────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
